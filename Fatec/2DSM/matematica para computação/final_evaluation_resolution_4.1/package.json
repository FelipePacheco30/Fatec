{
  "name": "planejamento-financeiro",
  "version": "1.0.0",
  "description": "Simulador de planejamento financeiro (TypeScript -> frontend)",
  "main": "server.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --sourcemap --format=esm --target=es2018 --outfile=public/bundle.js",
    "watch": "esbuild src/main.ts --bundle --sourcemap --format=esm --target=es2018 --outfile=public/bundle.js --watch",
    "serve": "node server.js",
    "start": "npm run build && npm run serve"
  },
  "author": "Felipe e Carlos",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.18.20"
  },
  "dependencies": {
    "express": "^4.19.2"
  }
}
