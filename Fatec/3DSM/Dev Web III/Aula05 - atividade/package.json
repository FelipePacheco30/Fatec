{
  "name": "lista-compras",
  "version": "1.0.0",
  "description": "CRUD Lista de Compras - TypeScript com MongoDB",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:client": "cd client && npm run build",
    "build:all": "npm run build && npm run build:client",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:client": "cd client && npm run dev"
  },
  "keywords": ["lista", "compras", "crud", "mongodb", "typescript"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mongoose": "^8.0.3"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/mongoose": "^5.11.97",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
